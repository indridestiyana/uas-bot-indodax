# =============================================================================
# CONTOH VARIABEL LINGKUNGAN (ENVIRONMENT VARIABLES)
# SALIN BERKAS INI MENJADI .env DAN ISI DENGAN NILAI ANDA SENDIRI
# JANGAN PERNAH MENYIMPAN ATAU MENG-COMMIT TOKEN/SECRET ASLI KE GITHUB!
# =============================================================================

# Rahasia Pengaman Endpoint Bot (/api/tick)
CRON_SECRET=rahasia_cron_acak_anda_di_sini_12345

# Saklar Darurat Kill Switch (0: Berjalan Normal, 1: Berhenti Total)
BOT_KILL_SWITCH=0

# Konfigurasi Storage Persisten Cloud (Upstash Redis / Vercel KV)
# Dapatkan gratis dari dashboard Upstash Console atau Vercel Storage Marketplace
KV_REST_API_URL=https://your-upstash-redis-instance.upstash.io
KV_REST_API_TOKEN=your_upstash_redis_rest_token_here
